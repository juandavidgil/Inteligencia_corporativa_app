{
  "expo": {
    "name": "Inteligencia Corporativa",
    "slug": "Inteligencia_Corporativa_app",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/img/data.png",
    "splash": {
      "image": "./assets/img/data.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "scheme": "inteligenciacorporativaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled":true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.productonopara.inteligenciacorporativa",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.producto_no_para.inteligenciacorporativa",
      "googleServicesFile": "./google-services.json", 
      "icon": "./assets/img/data.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/data.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b765574-3868-4e85-a0ed-7973370e2764"
      }
    }
  }
}