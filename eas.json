{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "ios-production": {
      "distribution": "app-store",
      "autoIncrement": true,
      "releaseChannel": "production",
      "workflow": "managed"
    },
    "android-local": {
      "distribution": "internal",
      "workflow": "generic"
    },
    "development": {
      "distribution": "internal",
      "developmentClient": true,
      "workflow": "managed"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "TU_APPLE_ID",
        "ascAppId": "TU_APP_ID"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}